# TradeSense Cloud Configuration for GitHub Student Pack
# Optimized for lightweight local development + cloud AI services

# ============================================================================
# ENVIRONMENT
# ============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================================================
# LOCAL DATABASE (Lightweight Docker)
# ============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tradesense
POSTGRES_USER=tradesense
POSTGRES_PASSWORD=dev_password

# Local Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=dev_password

# ============================================================================
# AZURE OPENAI SERVICE (FREE with $100 Student Credit)
# ============================================================================
# Get keys from: https://portal.azure.com
AZURE_OPENAI_KEY=your_azure_openai_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Model deployments
AZURE_OPENAI_DEPLOYMENT_GPT4=gpt-4
AZURE_OPENAI_DEPLOYMENT_GPT35=gpt-35-turbo
AZURE_OPENAI_DEPLOYMENT_GPT4_VISION=gpt-4-vision

# Use Azure OpenAI instead of local models
USE_AZURE_OPENAI=true
USE_LOCAL_LLM=false

# ============================================================================
# AZURE SPEECH SERVICES (FREE with $100 Student Credit)
# ============================================================================
# Get keys from: https://portal.azure.com
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus

# Voice configuration
AZURE_SPEECH_LANGUAGE=en-US
AZURE_SPEECH_VOICE=en-US-JennyNeural
AZURE_SPEECH_RECOGNITION_MODE=conversation

# Use Azure Speech instead of local Whisper/Piper
USE_AZURE_SPEECH=true
USE_LOCAL_VOICE=false

# ============================================================================
# OPEN-SOURCE COMMUNICATION (WebRTC + Jitsi + Notifications)
# ============================================================================
# WebRTC Signaling Server (self-hosted, FREE)
WEBRTC_SIGNALING_URL=ws://localhost:8080
WEBRTC_STUN_SERVER=stun:stun.l.google.com:19302
WEBRTC_TURN_SERVER=turn:your-turn-server.com:3478
WEBRTC_TURN_USERNAME=your_turn_username
WEBRTC_TURN_PASSWORD=your_turn_password

# Jitsi Meet Integration (FREE, self-hosted or jitsi.org)
JITSI_DOMAIN=meet.jit.si
JITSI_ROOM_PREFIX=tradesense-
JITSI_JWT_APP_ID=your_jitsi_app_id
JITSI_JWT_SECRET=your_jitsi_jwt_secret

# Web Push Notifications (FREE)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@tradesense.local

# Email Notifications (FREE with Gmail/Outlook)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=TradeSense <noreply@tradesense.local>

# Discord Webhooks (FREE, optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Optional: FreeSWITCH for Traditional Phone System ($2-5/month)
FREESWITCH_HOST=localhost
FREESWITCH_PORT=8021
FREESWITCH_PASSWORD=ClueCon
FREESWITCH_SIP_DOMAIN=your-domain.com
FREESWITCH_DID_NUMBER=+1234567890

# ============================================================================
# DATADOG (FREE Pro Account for 2 Years with Student Pack)
# ============================================================================
# Get keys from: https://app.datadoghq.com
DATADOG_API_KEY=your_datadog_api_key
DATADOG_APP_KEY=your_datadog_app_key
DATADOG_SITE=datadoghq.com
DATADOG_SERVICE=tradesense
DATADOG_ENV=development

# Use Datadog instead of self-hosted observability
USE_DATADOG=true
USE_LANGFUSE=false
USE_PHOENIX=false

# ============================================================================
# SENTRY (FREE 500k Events/Month with Student Pack)
# ============================================================================
# Get DSN from: https://sentry.io
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# ============================================================================
# PRODUCTION DATABASE OPTIONS (Choose one when deploying)
# ============================================================================

# Option A: Azure Database for PostgreSQL (Recommended, $100 credit)
# PROD_DATABASE_URL=postgresql://user:pass@your-server.postgres.database.azure.com:5432/tradesense?sslmode=require

# Option B: DigitalOcean Managed PostgreSQL ($200 credit)
# PROD_DATABASE_URL=postgresql://user:pass@your-db.db.ondigitalocean.com:25060/tradesense?sslmode=require

# Option C: Heroku PostgreSQL (FREE hobby tier)
# PROD_DATABASE_URL=postgresql://user:pass@ec2-host.compute-1.amazonaws.com:5432/dbname

# ============================================================================
# PRODUCTION REDIS OPTIONS (Choose one when deploying)
# ============================================================================

# Option A: Azure Cache for Redis (Recommended, $100 credit)
# PROD_REDIS_URL=rediss://:password@your-cache.redis.cache.windows.net:6380/0?ssl_cert_reqs=required

# Option B: DigitalOcean Managed Redis ($200 credit)
# PROD_REDIS_URL=rediss://default:password@your-redis.db.ondigitalocean.com:25061

# Option C: Heroku Redis (FREE hobby tier)
# PROD_REDIS_URL=redis://h:password@ec2-host.compute-1.amazonaws.com:12345

# ============================================================================
# API CONFIGURATION
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2  # Reduced for lightweight system
API_RELOAD=true

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
JWT_SECRET_KEY=changeme_jwt_secret_key_min_32_chars_for_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============================================================================
# SECURITY
# ============================================================================
ENCRYPTION_KEY=changeme_encryption_key_32_bytes_for_production

# OAuth 2.0 (optional)
OAUTH_CLIENT_ID=your_oauth_client_id
OAUTH_CLIENT_SECRET=your_oauth_client_secret
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_VOICE_PIPELINE=true
ENABLE_CARBON_TRACKING=true
ENABLE_MULTIMODAL=true

# Cloud-based features (enabled)
ENABLE_AZURE_OPENAI=true
ENABLE_AZURE_SPEECH=true
ENABLE_DATADOG=true
ENABLE_SENTRY=true

# Local heavy features (disabled to save RAM)
ENABLE_LOCAL_LLM=false
ENABLE_LOCAL_VOICE=false
ENABLE_OLLAMA=false
ENABLE_VLLM=false

# ============================================================================
# HARDWARE CONFIGURATION
# ============================================================================
# Deployment profile for lightweight system
DEPLOYMENT_PROFILE=cloud-light

# Reduced concurrency for lightweight system
MAX_CONCURRENT_VOICE_SESSIONS=5
MAX_CONCURRENT_JOBS=50

# ============================================================================
# GITHUB COPILOT (Development Only)
# ============================================================================
# GitHub Copilot is used via VS Code extension
# No API keys needed - uses your GitHub Student account
GITHUB_COPILOT_ENABLED=true

# ============================================================================
# OPTIONAL: ADDITIONAL STUDENT PACK SERVICES
# ============================================================================

# MongoDB Atlas (FREE tier + $50 credit)
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/tradesense?retryWrites=true&w=majority

# Stripe (Waived fees on first $1000)
# STRIPE_SECRET_KEY=sk_test_your_stripe_key
# STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key

# ============================================================================
# TESTING CONFIGURATION
# ============================================================================
TEST_DATABASE_URL=postgresql://tradesense:test@localhost:5433/tradesense_test
TEST_REDIS_URL=redis://:test@localhost:6380/0

# ============================================================================
# NOTES FOR SETUP
# ============================================================================
# 1. Activate GitHub Student Pack: https://education.github.com/pack
# 2. Create Azure account: https://azure.microsoft.com/en-us/free/students/
# 3. Create Azure OpenAI resource: https://portal.azure.com
# 4. Create Azure Speech resource: https://portal.azure.com
# 5. Sign up for Twilio: https://www.twilio.com/try-twilio
# 6. Sign up for Datadog: https://www.datadoghq.com/
# 7. Sign up for Sentry: https://sentry.io/signup/
# 8. Copy this file to .env and fill in your keys
# ============================================================================
