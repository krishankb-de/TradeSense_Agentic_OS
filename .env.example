# TradeSense Environment Configuration

# ============================================================================
# Database Configuration
# ============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tradesense
POSTGRES_USER=tradesense
POSTGRES_PASSWORD=changeme_secure_password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis_password

# ============================================================================
# LLM Configuration (Local Inference)
# ============================================================================
# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# vLLM Configuration (optional, for high-performance serving)
VLLM_HOST=http://localhost:8000
VLLM_DEFAULT_MODEL=deepseek-v3

# Model Selection Strategy: "ollama" or "vllm"
LLM_PROVIDER=ollama

# GPU Configuration
CUDA_VISIBLE_DEVICES=0
USE_GPU=true

# ============================================================================
# Voice Processing Configuration (Local)
# ============================================================================
# Faster-Whisper Configuration
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# Piper TTS Configuration
PIPER_VOICE=en_US-lessac-medium
PIPER_QUALITY=high

# Silero VAD Configuration
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_DURATION=250

# Voice Pipeline
VOICE_LATENCY_TARGET=500

# ============================================================================
# Twilio Configuration (Required for phone integration)
# ============================================================================
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WEBHOOK_URL=https://your-domain.com/api/webhooks/twilio

# ============================================================================
# InvenTree Configuration
# ============================================================================
INVENTREE_HOST=http://localhost:8080
INVENTREE_API_TOKEN=your_inventree_token

# ============================================================================
# Part-DB Configuration
# ============================================================================
PARTDB_HOST=http://localhost:8081
PARTDB_API_TOKEN=your_partdb_token

# ============================================================================
# KiCost Configuration
# ============================================================================
KICOST_DISTRIBUTORS=digikey,mouser,arrow,newark,tme
KICOST_CACHE_TTL=300

# ============================================================================
# Carbon Tracking Configuration
# ============================================================================
# Kabaun Configuration
KABAUN_EMISSION_FACTORS_PATH=/data/emission-factors
KABAUN_REGION=US

# CodeCarbon Configuration
CODECARBON_ENABLED=true
CODECARBON_TRACKING_MODE=process

# ============================================================================
# Observability Configuration (Self-Hosted)
# ============================================================================
# Langfuse Configuration
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key

# Arize Phoenix Configuration
PHOENIX_HOST=http://localhost:6006
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces

# Prometheus Configuration
PROMETHEUS_HOST=http://localhost:9090

# Grafana Configuration
GRAFANA_HOST=http://localhost:3001
GRAFANA_ADMIN_PASSWORD=changeme_grafana_password

# ============================================================================
# ZenML Configuration
# ============================================================================
ZENML_STORE_TYPE=local
ZENML_SECRETS_MANAGER=local

# ============================================================================
# API Configuration
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true

# JWT Configuration
JWT_SECRET_KEY=changeme_jwt_secret_key_min_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============================================================================
# Security Configuration
# ============================================================================
# OAuth 2.0 Configuration (optional)
OAUTH_CLIENT_ID=your_oauth_client_id
OAUTH_CLIENT_SECRET=your_oauth_client_secret
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# Encryption
ENCRYPTION_KEY=changeme_encryption_key_32_bytes

# ============================================================================
# Application Configuration
# ============================================================================
# Environment: development, staging, production
ENVIRONMENT=development

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Feature Flags
ENABLE_VOICE_PIPELINE=true
ENABLE_CARBON_TRACKING=true
ENABLE_MULTIMODAL=true

# ============================================================================
# Hardware Configuration
# ============================================================================
# Deployment Profile: solo, small, medium, enterprise
DEPLOYMENT_PROFILE=small

# Concurrency Limits
MAX_CONCURRENT_VOICE_SESSIONS=10
MAX_CONCURRENT_JOBS=100

# ============================================================================
# Testing Configuration
# ============================================================================
TEST_DATABASE_URL=postgresql://tradesense:test@localhost:5433/tradesense_test
TEST_REDIS_URL=redis://localhost:6380
